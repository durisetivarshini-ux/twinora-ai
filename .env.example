# Twinora AI Frontend Environment Variables Template
# Copy this file to .env or .env.local and fill in your Supabase project values

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Backend API URL (for local development use http://localhost:5000/api or production Render URL)
VITE_API_URL=http://localhost:5000/api
