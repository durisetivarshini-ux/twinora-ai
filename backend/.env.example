# Twinora AI Multi-Merchant Intelligence Backend Environment Variables
# Copy this file to backend/.env and provide your secret keys

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Server-Side Configuration (Optional - in-memory fallback enabled if not set)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Google Gemini API Key for Grounded Natural Language Explanations
GEMINI_API_KEY=your-google-gemini-api-key
